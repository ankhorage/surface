{
  "name": "@ankhorage/surface",
  "type": "module",
  "version": "9.1.43",
  "description": "Stable UI foundation for React Native and React Native Web.",
  "homepage": "https://github.com/ankhorage/surface#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/surface/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/surface.git"
  },
  "keywords": [
    "accessibility",
    "ankhorage",
    "components",
    "design-system",
    "expo",
    "foundation",
    "react-native",
    "react-native-web",
    "theming",
    "ui"
  ],
  "peerDependencies": {
    "@react-native-vector-icons/fontawesome": "^13.1.4",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "react": "19.3.0",
    "react-native": "0.86.x || 0.87.x",
    "react-native-gesture-handler": "~2.32.0 || ~3.3.0",
    "react-native-reanimated": "4.5.1 || 4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1 || 0.13.0"
  },
  "dependencies": {
    "@ankhorage/color-theory": "^0.3.1",
    "@ankhorage/contracts": "^22.8.35",
    "@ankhorage/utility": "^1.9.23",
    "@gorhom/bottom-sheet": "^5.2.14"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bottom-sheet": {
      "react-native": "./src/features/bottom-sheet/public.ts",
      "browser": "./src/features/bottom-sheet/public.ts",
      "types": "./dist/features/bottom-sheet/public.d.ts",
      "import": "./dist/features/bottom-sheet/public.js",
      "default": "./dist/features/bottom-sheet/public.js"
    },
    "./color": {
      "bun": "./src/constants/surfaceColor.ts",
      "react-native": "./src/constants/surfaceColor.ts",
      "browser": "./src/constants/surfaceColor.ts",
      "types": "./dist/constants/surfaceColor.d.ts",
      "import": "./dist/constants/surfaceColor.js",
      "default": "./dist/constants/surfaceColor.js"
    },
    "./theme": {
      "bun": "./src/features/theme/public.ts",
      "react-native": "./src/features/theme/public.ts",
      "browser": "./src/features/theme/public.ts",
      "types": "./dist/features/theme/public.d.ts",
      "import": "./dist/features/theme/public.js",
      "default": "./dist/features/theme/public.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox && ankhorage-prettier --write README.md paradox",
    "knip:check": "ankhorage-knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.0.19",
    "@ankhorage/paradox": "^0.2.10",
    "@react-native-vector-icons/fontawesome": "^13.1.4",
    "@react-native-vector-icons/fontawesome5": "^13.1.4",
    "@react-native-vector-icons/fontawesome6": "^13.1.4",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-native-web": "^0.19.3",
    "happy-dom": "^20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
