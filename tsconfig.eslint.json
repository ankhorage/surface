{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@ankhorage/surface": ["src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx"],
  "exclude": ["dist", "node_modules", "examples/**/node_modules", "examples/**/dist"]
}
